generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String?
  passwordHash String
  role         Role      @default(USER)
  image        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  accounts     Account[]
  sessions     Session[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

/// عميل
model Client {
  id        String    @id @default(cuid())
  name      String
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  bons      Bon[]
  payments  Payment[]

  @@map("clients")
}

/// بون توريد / فاتورة
model Bon {
  id              String    @id @default(cuid())
  clientId        String
  title           String
  date            DateTime  @default(now())
  containerNumber String?
  containerLabel  String?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  client          Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  lines           BonLine[]
  payments        Payment[]

  @@index([clientId])
  @@map("bons")
}

/// سطر تفصيلي داخل البون
/// - لو فيه مقاسات: المساحة = طول × عرض × عدد الشرايح
/// - الإجمالي = الكمية × سعر الوحدة (الكمية تُكتب يدوياً أو تُؤخذ من المساحة)
model BonLine {
  id          String   @id @default(cuid())
  bonId       String
  material    String
  finishing   String?
  palletCount Int      @default(0)
  slabCount   Int      @default(0)
  length      Float?
  width       Float?
  thickness   Float?
  quantity    Float    @default(0)
  unitPrice   Float    @default(0)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  bon         Bon      @relation(fields: [bonId], references: [id], onDelete: Cascade)

  @@index([bonId])
  @@map("bon_lines")
}

/// دفعة (دائن)
model Payment {
  id        String   @id @default(cuid())
  clientId  String
  bonId     String?
  amount    Float
  date      DateTime @default(now())
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  bon       Bon?     @relation(fields: [bonId], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@index([bonId])
  @@map("payments")
}
